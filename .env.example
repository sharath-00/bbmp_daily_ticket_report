# SMTP Email Configuration Example
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAILS=official1@example.com,official2@example.com

EMAIL_SUBJECT_PREFIX=[BBMP Smart Light Ticket Report]
DEFAULT_REPORT_PERIOD=today
